<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="caid_bot">

  <xacro:arg name="dims_file" default="$(find caid_description)/config/dimensions.yaml"/>
  <xacro:include filename="$(find caid_description)/urdf/inertia.xacro"/>

  <xacro:property name="dim" value="${xacro.load_yaml('$(arg dims_file)')}"/>
  <xacro:property name="mm" value="0.001"/>

  <xacro:property name="largo" value="${dim['placa_acrilico']['largo_x'] * mm}"/>
  <xacro:property name="ancho" value="${dim['placa_acrilico']['ancho_y'] * mm}"/>
  <xacro:property name="h_base" value="${dim['alturas_desde_el_piso']['cara_superior_piso_2'] * mm}"/>
  <xacro:property name="m_base" value="1.2"/>
  <xacro:property name="r_rueda" value="${dim['rueda']['radio'] * mm}"/>
  <xacro:property name="w_rueda" value="${dim['rueda']['ancho'] * mm}"/>
  <xacro:property name="x_del" value="${dim['tren_de_traccion']['posicion_x_ruedas'][0] * mm}"/>
  <xacro:property name="x_tras" value="${dim['tren_de_traccion']['posicion_x_ruedas'][1] * mm}"/>
  <xacro:property name="y_rueda" value="${dim['tren_de_traccion']['trocha_centro_a_centro'] * mm / 2}"/>
  <xacro:property name="z_eje" value="${r_rueda - h_base}"/>
  <xacro:property name="m_rueda" value="0.04"/>
  <xacro:property name="esp" value="${dim['placa_acrilico']['espesor'] * mm}"/>
  <xacro:property name="sep" value="${dim['placa_acrilico']['separacion_entre_placas'] * mm}"/>

  <!-- Altura de la cara INFERIOR de cada placa, en el marco base_link (el origen está en la
       cara superior del piso 2). La malla del STL tiene su cara inferior en z=0. -->
  <xacro:property name="z_piso2" value="${-esp}"/>
  <xacro:property name="z_piso1" value="${-(esp + sep + esp)}"/>
  <xacro:property name="z_sobre_p1" value="${-(esp + sep)}"/>   <!-- cara superior del piso 1 -->
  <xacro:property name="alto_pared" value="${dim['paredes']['alto'] * mm}"/>
  <xacro:property name="d_pf" value="${dim['paredes']['frontal_sobresale'] * mm}"/>
  <xacro:property name="d_pt" value="${dim['paredes']['trasera_sobresale'] * mm}"/>

  <!-- Caja envolvente (mm) de las mallas de las paredes: salen de leer los vértices de cada STL.
       Cada STL tiene su origen en una esquina, por eso hay que desplazarlas a mano. -->
  <xacro:property name="pf_xmin" value="2.21"/>   <xacro:property name="pf_xmax" value="165.21"/>
  <xacro:property name="pf_ymin" value="4.60"/>   <xacro:property name="pf_ymax" value="51.47"/>
  <xacro:property name="pf_zmin" value="0.97"/>
  <xacro:property name="pt_xmin" value="8.44"/>   <xacro:property name="pt_xmax" value="171.44"/>
  <xacro:property name="pt_ymin" value="8.46"/>   <xacro:property name="pt_ymax" value="53.44"/>
  <xacro:property name="pt_zmin" value="0.0"/>

  <material name="acrilico"><color rgba="0.75 0.85 1.0 0.6"/></material>
  <material name="pla_hueso"><color rgba="0.93 0.91 0.82 1.0"/></material>
  <material name="goma"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="pla_negro"><color rgba="0.12 0.12 0.12 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${h_base}" rpy="0 0 0"/>
  </joint>

    <link name="base_link">
    <!-- Piso 2 (arriba) -->
    <visual>
      <origin xyz="0 0 ${z_piso2}" rpy="0 0 ${pi}"/>
      <geometry>
        <mesh filename="package://caid_description/meshes/chasis_armadillo.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="acrilico"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${z_piso2 + esp/2}" rpy="0 0 0"/>
      <geometry><box size="${largo} ${ancho} ${esp}"/></geometry>
    </collision>

    <!-- Piso 1 (abajo) -->
    <visual>
      <origin xyz="0 0 ${z_piso1}" rpy="0 0 ${pi}"/>
      <geometry>
        <mesh filename="package://caid_description/meshes/chasis_armadillo_inferior.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="acrilico"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${z_piso1 + esp/2}" rpy="0 0 0"/>
      <geometry><box size="${largo} ${ancho} ${esp}"/></geometry>
    </collision>

        <!-- Pared frontal (0-2-10): giro +90° sobre z, cara curva hacia adelante, al ras del borde -->
    <visual>
      <origin xyz="${largo/2 + d_pf + pf_ymin*mm} ${-(pf_xmin + pf_xmax)/2*mm} ${z_sobre_p1 - pf_zmin*mm}" rpy="0 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://caid_description/meshes/pared_frente.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pla_hueso"/>
    </visual>
    <collision>
      <origin xyz="${largo/2 + d_pf - (pf_ymax - pf_ymin)*mm/2} 0 ${z_sobre_p1 + alto_pared/2}" rpy="0 0 0"/>
      <geometry><box size="${(pf_ymax - pf_ymin)*mm} ${(pf_xmax - pf_xmin)*mm} ${alto_pared}"/></geometry>
    </collision>

    <!-- Pared trasera (0-2-20): giro -90° sobre z, cara curva hacia atrás -->
    <visual>
      <origin xyz="0 0 ${z_piso1}" rpy="0 0 ${pi}"/>
      <geometry>
        <mesh filename="package://caid_description/meshes/pared_posterior.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pla_hueso"/>
    </visual>
    <collision>
      <origin xyz="${-largo/2 - d_pt + (pt_ymax - pt_ymin)*mm/2} 0 ${z_sobre_p1 + alto_pared/2}" rpy="0 0 0"/>
      <geometry><box size="${(pt_ymax - pt_ymin)*mm} ${(pt_xmax - pt_xmin)*mm} ${alto_pared}"/></geometry>
    </collision>

    <xacro:box_inertia m="${m_base}" x="${largo}" y="${ancho}" z="${h_base}" o_xyz="0 0 ${-h_base/2}"/>
  </link>

    <!-- Rueda: el eje de giro es y. El cilindro de URDF tiene su eje en z, por eso se gira 90° sobre x. -->
  <xacro:macro name="rueda" params="name x y">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${r_rueda}" length="${w_rueda}"/></geometry>
        <material name="goma"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${r_rueda}" length="${w_rueda}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${m_rueda}" r="${r_rueda}" h="${w_rueda}" o_rpy="${pi/2} 0 0"/>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z_eje}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:rueda name="wheel_fl" x="${x_del}"  y="${y_rueda}"/>
  <xacro:rueda name="wheel_fr" x="${x_del}"  y="${-y_rueda}"/>
  <xacro:rueda name="wheel_rl" x="${x_tras}" y="${y_rueda}"/>
  <xacro:rueda name="wheel_rr" x="${x_tras}" y="${-y_rueda}"/>

  <!-- ===== Ultrasonidos: un marco por sensor, en el punto medio entre sus dos ojos ===== -->
  <xacro:property name="us_f" value="${dim['sensores_ultrasonido']['frontal']}"/>
  <xacro:property name="us_l" value="${dim['sensores_ultrasonido']['lateral_izquierdo']}"/>
  <xacro:property name="us_r" value="${dim['sensores_ultrasonido']['lateral_derecho']}"/>

  <!-- El eje x del marco apunta hacia donde mira el sensor; yaw gira ese eje sobre z. -->
  <xacro:macro name="ultrasonido" params="name x y z yaw">
    <link name="${name}"/>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>

  <xacro:ultrasonido name="us_front" x="${us_f['x']*mm}" y="${us_f['y']*mm}" z="${us_f['z']*mm}" yaw="0"/>
  <xacro:ultrasonido name="us_left"  x="${us_l['x']*mm}" y="${us_l['y']*mm}" z="${us_l['z']*mm}" yaw="${pi/2}"/>
  <xacro:ultrasonido name="us_right" x="${us_r['x']*mm}" y="${us_r['y']*mm}" z="${us_r['z']*mm}" yaw="${-pi/2}"/>

  <!-- ===== Cámara: giro (revolute) -> cuerpo -> marco óptico (REP-103) ===== -->
  <xacro:property name="cam" value="${dim['camara']}"/>
  <xacro:property name="cam_x" value="0.0141"/>   <!-- espesor de la caja, del ensamblado -->
  <xacro:property name="cam_y" value="0.0352"/>
  <xacro:property name="cam_z" value="0.0447"/>

  <link name="camera_pan_link">
    <xacro:box_inertia m="0.01" x="0.03" y="0.03" z="0.02"/>
  </link>
  <joint name="camera_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="camera_pan_link"/>
    <origin xyz="${cam['x']*mm} ${cam['y']*mm} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="0.2" velocity="3.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${cam_x} ${cam_y} ${cam_z}"/></geometry>
      <material name="pla_negro"/>
    </visual>
    <xacro:box_inertia m="0.02" x="${cam_x}" y="${cam_y}" z="${cam_z}"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_pan_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 ${cam['z']*mm}" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="${cam_x/2} 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ===== Brazo: arm:=fixed (por defecto) o arm:=none; arm_yaw gira su base (rad) ===== -->
  <xacro:arg name="arm" default="actuated"/>
  <xacro:arg name="arm_yaw" default="0"/>
  <xacro:include filename="$(find caid_description)/urdf/arm.xacro"/>
  <xacro:brazo modo="$(arg arm)" yaw="$(arg arm_yaw)"
               x="${dim['brazo']['base_x']*mm}" y="${dim['brazo']['base_y']*mm}" z="${dim['brazo']['base_z']*mm}"/>

  <!-- ===== Simulación (Gazebo): solo si se pide sim:=true ===== -->
  <xacro:arg name="sim" default="false"/>
  <xacro:if value="$(arg sim)">
    <xacro:include filename="$(find caid_description)/urdf/gazebo.xacro"/>
  </xacro:if>

</robot>