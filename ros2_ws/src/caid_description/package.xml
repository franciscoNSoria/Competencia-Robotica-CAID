<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caid_description</name>
  <version>0.1.0</version>
  <description>Modelo 3D (URDF/xacro) del robot del Laberinto inteligente, CAID 2026</description>
  <maintainer email="francisco99soria@gmail.com">Francisco Soria</maintainer>
  <!-- Licencia provisoria: el repo todavía no tiene LICENSE. Cambiar cuando el equipo decida. -->
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Lo que hace falta para abrir el modelo en RViz (display.launch.xml) -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>urdfdom</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
